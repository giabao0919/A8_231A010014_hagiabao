<?xml version="1.0" encoding="utf-8"?>
<!-- [NC3] Sơ đồ điều hướng (Navigation Graph) thay thế quản lý Fragment thủ công -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/tab_home">

    <!-- Destination 1: Tab Trang chủ -->
    <fragment
        android:id="@+id/tab_home"
        android:name="vn.edu.vhu.ltdd.a8fragment.HomeFragment"
        android:label="@string/tab_home"
        tools:layout="@layout/fragment_home" />

    <!-- Destination 2: Tab Tin tức (Danh sách tin) -->
    <fragment
        android:id="@+id/tab_news"
        android:name="vn.edu.vhu.ltdd.a8fragment.NewsListFragment"
        android:label="@string/tab_news"
        tools:layout="@layout/fragment_news_list">

        <!-- [NC3 & NC4] Action chuyển từ Danh sách tin sang Chi tiết tin với hiệu ứng Animation -->
        <action
            android:id="@+id/action_newsList_to_detail"
            app:destination="@id/fragment_news_detail"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- Destination 3: Tab Cá nhân -->
    <fragment
        android:id="@+id/tab_profile"
        android:name="vn.edu.vhu.ltdd.a8fragment.ProfileFragment"
        android:label="@string/tab_profile"
        tools:layout="@layout/fragment_profile">
        <argument
            android:name="key_ten"
            android:defaultValue="Hà Gia Bảo"
            app:argType="string" />
        <argument
            android:name="key_mssv"
            android:defaultValue="231A010014"
            app:argType="string" />
    </fragment>

    <!-- Destination 4: Màn hình Chi tiết tin -->
    <fragment
        android:id="@+id/fragment_news_detail"
        android:name="vn.edu.vhu.ltdd.a8fragment.NewsDetailFragment"
        android:label="Chi tiết tin"
        tools:layout="@layout/fragment_news_detail">
        <argument
            android:name="key_tieu_de"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="key_noi_dung"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

</navigation>